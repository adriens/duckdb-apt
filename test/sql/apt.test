# name: test/sql/apt.test
# description: test apt extension
# group: [sql]

# Before we load the extension, this will fail
statement error
SELECT * FROM apt_packages();
----
Catalog Error: Table Function with name apt_packages does not exist!

# Require statement will ensure this test is run with this extension loaded
require apt

# Results depend on the host: 0 rows on systems without dpkg, many on Debian-based ones
query I
SELECT COUNT(*) >= 0 FROM apt_packages();
----
true

# Check the column structure
query I
SELECT COUNT(*) >= 0 FROM (
    SELECT name, version, architecture, section, priority, installed_size_kb, maintainer, homepage, source,
           description, multi_arch, auto_installed
    FROM apt_packages()
    LIMIT 1
);
----
true

# Installed packages always have a name and a version
query I
SELECT COUNT(*) FROM apt_packages() WHERE name IS NULL OR version IS NULL;
----
0

# Every dependency row refers to an installed package
query I
SELECT COUNT(*) FROM apt_dependencies() d
WHERE d.package NOT IN (SELECT name FROM apt_packages());
----
0

query I
SELECT COUNT(*) >= 0 FROM (
    SELECT package, architecture, relation, dependency, version_constraint, alternative FROM apt_dependencies() LIMIT 1
);
----
true

query I
SELECT COUNT(*) >= 0 FROM (
    SELECT package, architecture, provides, version FROM apt_provides() LIMIT 1
);
----
true

# Every provider is an installed package
query I
SELECT COUNT(*) FROM apt_provides() WHERE package NOT IN (SELECT name FROM apt_packages());
----
0

# Architecture qualifiers such as "python3:any" are stripped
query I
SELECT COUNT(*) FROM apt_dependencies() WHERE dependency LIKE '%:%';
----
0

# On a consistent system every non-alternative hard dependency is satisfied by a package or a Provides
query I
SELECT COUNT(*) FROM apt_dependencies()
WHERE relation IN ('Depends', 'Pre-Depends') AND NOT alternative
  AND dependency NOT IN (SELECT name FROM apt_packages())
  AND dependency NOT IN (SELECT provides FROM apt_provides());
----
0

query I
SELECT COUNT(*) >= 0 FROM (
    SELECT file, format, enabled, type, uri, suite, components, architectures, signed_by, trusted
    FROM apt_sources() LIMIT 1
);
----
true

query I
SELECT COUNT(*) FROM apt_sources()
WHERE type NOT IN ('deb', 'deb-src') OR format NOT IN ('one-line', 'deb822') OR uri IS NULL OR suite IS NULL;
----
0

query I
SELECT COUNT(*) >= 0 FROM (
    SELECT name, architecture, installed_version, available_version, is_installed_version, origin, label, suite,
           codename, component, site
    FROM apt_package_origins() LIMIT 1
);
----
true

# Origins are only reported for installed packages, with their installed version
query I
SELECT COUNT(*) FROM apt_package_origins() o
LEFT JOIN apt_packages() p USING (name, architecture)
WHERE p.name IS NULL OR p.version <> o.installed_version
   OR o.is_installed_version <> (o.installed_version = o.available_version);
----
0

query I
SELECT COUNT(*) >= 0 FROM (
    SELECT name, architecture, current_version, new_version, repository, is_security FROM apt_upgradable() LIMIT 1
);
----
true

query I
SELECT typeof(apt_version());
----
VARCHAR
