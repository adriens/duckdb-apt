# name: test/sql/apt_fixtures.test
# description: test the apt parsers on the fake Debian system in test/data/debian
# group: [sql]

require apt

# A root without any apt/dpkg files behaves like a non-Debian system
query I
SELECT COUNT(*) FROM apt_packages(root := 'test/data/does-not-exist');
----
0

query I
SELECT COUNT(*) FROM apt_sources(root := 'test/data/does-not-exist');
----
0

query I
SELECT COUNT(*) FROM apt_package_origins(root := 'test/data/does-not-exist');
----
0

# A trailing slash is accepted
query I
SELECT COUNT(*) FROM apt_packages(root := 'test/data/debian/');
----
7

# Packages removed with leftover config files (oldpkg) are excluded, held ones (localtool) are kept.
# postfix is not auto-installed: its extended_states entry is for another architecture.
query IIIIIIIIIIII
SELECT * FROM apt_packages(root := 'test/data/debian') ORDER BY name;
----
curl	7.88.1-10+deb12u5	amd64	web	optional	500	Debian Curl Maintainers <team+curl@tracker.debian.org>	https://curl.se	curl	command line tool for transferring data with URL syntax	NULL	false
libc6	2.36-9+deb12u1	amd64	libs	required	12000	Debian GLIBC Maintainers <debian-glibc@lists.debian.org>	https://www.gnu.org/software/libc/libc.html	glibc	GNU C Library: Shared libraries	same	true
libgcc-s1	12.2.0-14	amd64	libs	optional	140	Debian GCC Maintainers <debian-gcc@lists.debian.org>	NULL	gcc-12	GCC support library	same	true
localtool	1.0	all	NULL	NULL	10	Local Admin <admin@example.org>	NULL	localtool	tool installed from a local .deb	NULL	false
postfix	3.7.11-0+deb12u1	amd64	mail	optional	4000	LaMont Jones <lamont@debian.org>	NULL	postfix	High-performance mail transport agent	NULL	false
python3	3.11.2-1+b1	amd64	python	optional	90	Matthias Klose <doko@debian.org>	NULL	python3-defaults	interactive high-level object-oriented language (default python3 version)	allowed	false
tzdata	2024a-0+deb12u1	all	localization	required	3200	GNU Libc Maintainers <debian-glibc@lists.debian.org>	NULL	tzdata	time zone and daylight-saving time data	foreign	false

# Multi-line fields are joined, ":any" qualifiers and "[arch] <profile>" restrictions are stripped,
# and each alternative of "a | b" is a row
query IIIIII
SELECT * FROM apt_dependencies(root := 'test/data/debian') ORDER BY package, relation, dependency;
----
curl	amd64	Depends	libc6	>= 2.34	false
curl	amd64	Depends	mail-transport-agent	NULL	true
curl	amd64	Depends	postfix	NULL	true
curl	amd64	Depends	python3	NULL	false
curl	amd64	Recommends	ca-certificates	NULL	false
curl	amd64	Suggests	curl-doc	NULL	false
libc6	amd64	Depends	libgcc-s1	NULL	false
postfix	amd64	Depends	libc6	>= 2.34	false

query IIII
SELECT * FROM apt_provides(root := 'test/data/debian') ORDER BY package, provides;
----
libc6	amd64	libc6-abi	2.36
postfix	amd64	default-mta	NULL
postfix	amd64	mail-transport-agent	NULL
python3	amd64	python3-profiler	3.11.2-1+b1

# Every hard dependency is satisfied by a package or a Provides
query I
SELECT COUNT(*) FROM apt_dependencies(root := 'test/data/debian')
WHERE relation IN ('Depends', 'Pre-Depends') AND NOT alternative
  AND dependency NOT IN (SELECT name FROM apt_packages(root := 'test/data/debian'))
  AND dependency NOT IN (SELECT provides FROM apt_provides(root := 'test/data/debian'));
----
0

# Comments and files with other extensions (ignored.list.disabled) are skipped, one-line options are parsed,
# deb822 stanzas expand to one row per type x URI x suite, inline keys are not dumped
query IIIIIIIIII
SELECT replace(file, 'test/data/debian', ''), * EXCLUDE (file)
FROM apt_sources(root := 'test/data/debian')
ORDER BY file, type, suite;
----
/etc/apt/sources.list	one-line	true	deb	http://deb.example.org/debian	bookworm	[main, contrib]	[amd64, i386]	/usr/share/keyrings/debian-archive-keyring.gpg	false
/etc/apt/sources.list	one-line	true	deb-src	http://deb.example.org/debian	bookworm	[main]	NULL	NULL	false
/etc/apt/sources.list.d/insecure.list	one-line	true	deb	http://insecure.example.org/repo	./	NULL	NULL	NULL	true
/etc/apt/sources.list.d/vendor.sources	deb822	true	deb	https://security.example.org/debian-security	bookworm-security	[main]	NULL	(inline key)	false
/etc/apt/sources.list.d/vendor.sources	deb822	true	deb	https://security.example.org/debian-security	bookworm-updates	[main]	NULL	(inline key)	false
/etc/apt/sources.list.d/vendor.sources	deb822	false	deb	https://vendor.example.org/apt	stable	[main]	[amd64]	NULL	true
/etc/apt/sources.list.d/vendor.sources	deb822	false	deb-src	https://vendor.example.org/apt	stable	[main]	[amd64]	NULL	true

# Repository metadata comes from InRelease (clearsigned) or Release; "all" packages listed in several
# architecture indexes (tzdata) are reported once; packages of other architectures (libc6:i386) are ignored
query IIIIIIIIIII
SELECT * FROM apt_package_origins(root := 'test/data/debian') ORDER BY name, architecture, site, suite;
----
curl	amd64	7.88.1-10+deb12u5	7.88.1-10+deb12u4	false	Debian	Debian	stable	bookworm	main	deb.example.org/debian
curl	amd64	7.88.1-10+deb12u5	7.88.1-10+deb12u5	true	Debian	Debian-Security	stable-security	bookworm-security	main	security.example.org/debian-security
libc6	amd64	2.36-9+deb12u1	2.36-9+deb12u1	true	Debian	Debian	stable	bookworm	main	deb.example.org/debian
libc6	amd64	2.36-9+deb12u1	2.36-9+deb12u1	true	Debian	Debian-Security	stable-security	bookworm-security	main	security.example.org/debian-security
libgcc-s1	amd64	12.2.0-14	12.2.0-14	true	Debian	Debian	stable	bookworm	main	deb.example.org/debian
postfix	amd64	3.7.11-0+deb12u1	3.7.11-0+deb12u1	true	Debian	Debian	stable	bookworm	main	deb.example.org/debian
python3	amd64	3.11.2-1+b1	3.11.2-1+b1	true	Debian	Debian	stable	bookworm	main	deb.example.org/debian
tzdata	all	2024a-0+deb12u1	2024a-0+deb12u1	true	Debian	Debian	stable	bookworm	main	deb.example.org/debian

# Orphaned packages: unknown to every configured repository
query I
SELECT name FROM apt_packages(root := 'test/data/debian')
ANTI JOIN apt_package_origins(root := 'test/data/debian') USING (name, architecture)
ORDER BY name;
----
localtool

statement error
SELECT * FROM apt_packages(root := 42, unknown := 1);
----
<REGEX>:.*Binder Error.*unknown.*
